{
  "name": "vmf-v-1-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seeds/index.js",
    "db:clean:keep-super-admin": "node src/scripts/cleanDbKeepSuperAdmin.js",
    "framework-seed:guard": "node src/scripts/importFrameworkSeed.js --json --no-report",
    "framework-seed:import": "node src/scripts/importFrameworkSeed.js",
    "framework-seed:replace-active": "node src/scripts/replaceActiveFrameworkPackageFromSeed.js",
    "framework-packages:repair-release-metadata": "node src/scripts/repairActiveFrameworkPackageReleaseMetadata.js",
    "framework-packages:repair-section-generation-actions": "node src/scripts/repairActiveFrameworkPackageSectionGenerationActions.js",
    "vmf:cleanup-pre-v3-1": "node src/scripts/cleanupPreV31VmfRecords.js",
    "runtime-paths:reclassify-categories": "node src/scripts/reclassifyRuntimePathCategories.js",
    "knowledge-packs:backfill-categories": "node src/scripts/backfillKnowledgePackCategories.js",
    "knowledge-packs:reconcile-metadata": "node src/scripts/reconcileKnowledgePackMetadata.js",
    "knowledge-packs:rehearse-metadata": "node src/scripts/rehearseKnowledgePackMetadataReconciliation.js",
    "knowledge-packs:audit-layer-readiness": "node src/scripts/auditKnowledgePackLayerReadiness.js",
    "knowledge-packs:apply-governance-mapping": "node src/scripts/applyKnowledgePackGovernanceMapping.js",
    "knowledge-packs:author-v1-assets": "node src/scripts/authorKnowledgePackV1Assets.js",
    "framework-packages:unset-legacy-fields": "node src/scripts/unsetDeprecatedFrameworkPackageFields.js",
    "framework-packages:drop-legacy-active-index": "node src/scripts/dropLegacyFrameworkPackageActiveIndex.js",
    "runtime-deployments:migrate-active-index": "node src/scripts/migrateRuntimeDeploymentActiveIndex.js",
    "runtime-deployments:restore-package": "node src/scripts/restoreRuntimePackageDeployment.js",
    "customers:enforce-name-uniqueness": "node src/scripts/enforceCustomerNameUniqueness.js",
    "governance:backfill": "node src/scripts/backfillCustomerLicenseGovernance.js",
    "governance:report-admin-invariants": "node src/scripts/reportCustomerAdminInvariantViolations.js",
    "knowledge-packs:retire-starter": "node src/scripts/retireOutcomeStarterKnowledgePacks.js",
    "test": "set NODE_ENV=test && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docx": "9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "3.10.1",
    "mongoose": "^8.18.2",
    "pdfjs-dist": "^4.3.136",
    "pdfkit": "0.19.1",
    "pino": "^9.5.0",
    "pino-http": "^9.0.0",
    "playwright-core": "1.61.1",
    "pptxgenjs": "4.0.1",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "saxes": "6.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globals": {
      "__dirname": false,
      "__filename": false
    },
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ]
  },
  "description": "This folder contains the production-ready Node/Express API server. It defaults to port 8000 and includes hardened middleware (security headers, CORS, rate limiting, request logging) plus a health endpoint.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoryDevGA/VMF-v-1-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/StoryDevGA/VMF-v-1-api/issues"
  },
  "homepage": "https://github.com/StoryDevGA/VMF-v-1-api#readme"
}
