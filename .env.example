PORT=8000
NODE_ENV=development
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
TRUST_PROXY=0

# Required
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_REQUIRED=false

# Security
AUDIT_SIGNATURE_SECRET=

# Identity Plus (optional)
IDENTITY_PLUS_API_URL=
IDENTITY_PLUS_API_KEY=
IDENTITY_PLUS_WEBHOOK_SECRET=
IDENTITY_PLUS_AUTH_URL=

# Monitoring
APP_VERSION=0.1.0
METRICS_PREFIX=vmf_api_
MONITORING_WINDOW_MS=300000
MONITORING_LATENCY_P95_THRESHOLD_MS=200
MONITORING_ERROR_RATE_THRESHOLD=0.05
MONITORING_EVENT_LOOP_LAG_THRESHOLD_MS=100
MONITORING_HEAP_USAGE_THRESHOLD_PCT=85

# Fake auth (non-production app environments only)
FAKE_AUTH_ENABLED=false

# Governance rollout controls
GOVERNANCE_LICENSE_LEVELS_ENABLED=true
GOVERNANCE_STRICT_ADMIN_INVARIANT_ENABLED=true
GOVERNANCE_INACTIVE_ENFORCEMENT_ENABLED=true
GOVERNANCE_EXTERNAL_ONBOARDING_ENABLED=true

# Optional system actor override for backfill/seed scripts
SYSTEM_ACTOR_USER_ID=
